
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MyCSharpApp/bin/Debug/net10.0/MyCSharpApp.dll",
            "cwd": "${workspaceFolder}/MyCSharpApp",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
